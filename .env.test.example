# Read only when running the suites on the host. `make test-api-e2e` runs them in a container,
# where this file is absent and every setting is passed in explicitly.
#
# These point at the stack in docker-compose.test.yml. Start it with `make test-api-services`.
#
# Never point DB_CONNECTION_URI at the dev database: the e2e harness runs
# `DROP SCHEMA public CASCADE` on whatever database it is given, before every run.
REDIS_URL=redis://localhost:6380
DB_CONNECTION_URI=postgres://infisical:infisical@localhost:5436/infisical-test?sslmode=disable

