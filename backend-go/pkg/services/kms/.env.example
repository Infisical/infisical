# Runtime
NODE_ENV=development
LOG_LEVEL=info
INFISICAL_PLATFORM_VERSION=
KUBERNETES_AUTO_FETCH_SERVICE_ACCOUNT_TOKEN=false
STANDALONE_MODE=false
INFISICAL_CLOUD=false
MAINTENANCE_MODE=false

# KMS gRPC server
KMS_GRPC_ADDR=127.0.0.1
KMS_GRPC_PORT=4040
KMS_GRPC_TLS_ENABLED=false
KMS_GRPC_TLS_CA_CERT=
KMS_GRPC_TLS_CLIENT_CERT=
KMS_GRPC_TLS_CLIENT_KEY=
KMS_GRPC_TLS_SERVER_NAME=
KMS_AUTH_HEADER=x-infisical-kms-auth
KMS_AUTH_SECRET=dev-kms-secret-change-me

# Database
DB_CONNECTION_URI=
DB_ROOT_CERT=
DB_HOST=
DB_PORT=5432
DB_USER=
DB_PASSWORD=
DB_NAME=
DB_READ_REPLICAS=

# Redis
REDIS_URL=
REDIS_USERNAME=
REDIS_PASSWORD=
REDIS_SENTINEL_HOSTS=
REDIS_SENTINEL_MASTER_NAME=mymaster
REDIS_SENTINEL_ENABLE_TLS=false
REDIS_SENTINEL_USERNAME=
REDIS_SENTINEL_PASSWORD=
REDIS_CLUSTER_HOSTS=
REDIS_CLUSTER_ENABLE_TLS=false
REDIS_CLUSTER_AWS_ELASTICACHE_DNS_LOOKUP_MODE=false
REDIS_READ_REPLICAS=

# Encryption and TLS
ENCRYPTION_KEY=
ROOT_ENCRYPTION_KEY=
FIPS_ENABLED=false
SITE_URL=
HTTPS_ENABLED=false

# HSM
HSM_LIB_PATH=
HSM_PIN=
HSM_KEY_LABEL=
HSM_SLOT=0

# License
LICENSE_SERVER_URL=https://portal.infisical.com
LICENSE_SERVER_KEY=
LICENSE_KEY=
LICENSE_KEY_OFFLINE=

# Application
TELEMETRY_ENABLED=true
SALT_ROUNDS=10
ROTATION_DEVELOPMENT_MODE=false
DAILY_RESOURCE_CLEAN_UP_DEVELOPMENT_MODE=false

# Disable the KMS-key metadata cache. This also disables Raft.
DISABLE_CACHE=false
# Keep this enabled for a single-node deployment. Set false only for a configured Raft cluster.
DISABLE_RAFT=true
RAFT_NODE_ID=
RAFT_PEERS= # include kms-service peers , gateway services peers , forming same cluster
RAFT_WAL_DIR=
RAFT_SNAPSHOT_DIR=
RAFT_CLUSTER_BOOTSTRAP_DONE=false
