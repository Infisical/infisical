{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "plugins": [],
  "jsPlugins": ["@shadcn/lint"],
  "categories": {
    "correctness": "off"
  },
  "settings": {
    "shadcn": {
      "ui": "@infisical/cipher/ui",
      "componentImports": ["^@infisical/cipher/ui(/|$)"],
      "note": "Tokens live in @infisical/cipher/tokens.json. Corners are square everywhere."
    }
  },
  "rules": {
    "shadcn/no-raw-colors": "error",
    "shadcn/no-restyle": ["error", { "allow": ["layout"] }]
  }
}
