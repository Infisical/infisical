# Claude API key. Used by the compiler (L2), the agentic runner (L4) and the judge (L5).
# The extractor and image linter need none of this and run offline.
ANTHROPIC_API_KEY=

# Base URL of the Infisical instance under test.
# Matches SITE_URL in the root .env, and the port nginx publishes in docker-compose.dev.yml.
GUIDERAILS_BASE_URL=http://localhost:8080

# You do not set the admin credentials. `env up` generates a password, bootstraps the
# instance, and writes the whole set (email, password, org id) to
# guiderails/.guiderails-state.json, which is gitignored. Every later command reads that file.
# `env up` also prints them once so you can log in by hand if you want to look around.

# Enterprise license. Without it most access-control and workflow guides are gated off
# and their steps get reported as unverified rather than passing.
LICENSE_KEY_OFFLINE=

# Port for the live dashboard, served by `run --live` and by `live`.
GUIDERAILS_LIVE_PORT=4488

# Set to a path to tee a walk's event stream to JSONL, so `guiderails live` can replay it with no
# instance and no API spend. Unset by default: frames make it about 10MB a minute.
# GUIDERAILS_LIVE_RECORD=reports/last-run.jsonl
