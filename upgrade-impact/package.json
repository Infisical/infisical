{
  "name": "@infisical/upgrade-impact",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "packageManager": "npm@11.19.0",
  "engines": {
    "node": ">=22.22.2 <23",
    "npm": ">=11.19.0 <12"
  },
  "devEngines": {
    "runtime": {
      "name": "node",
      "version": ">=22.22.2 <23",
      "onFail": "error"
    },
    "packageManager": {
      "name": "npm",
      "version": ">=11.19.0 <12",
      "onFail": "error"
    }
  },
  "allowScripts": {
    "esbuild@0.27.7": false,
    "fsevents@2.3.3": false
  },
  "scripts": {
    "generate": "tsx scripts/generate.ts",
    "generate:dry-run": "tsx scripts/generate.ts --dry-run",
    "generate:local": "tsx scripts/local-generate.ts",
    "generate:local:no-ai": "tsx scripts/local-generate.ts --no-ai",
    "test": "vitest run",
    "type:check": "tsc --noEmit",
    "validate": "tsx scripts/validate.ts"
  },
  "dependencies": {
    "@openai/agents": "^0.8.5",
    "yaml": "^2.8.3",
    "zod": "^4.4.1"
  },
  "devDependencies": {
    "@types/node": "^22.19.17",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3",
    "vitest": "^3.2.4"
  }
}
